# =============================================================================
# LOCAL DEVELOPMENT — copy to frontend/.env.local
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
TATTOO_BACKEND_URL=http://localhost:8000
TATTOO_SERVICE_KEY=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# PRODUCTION (Vercel) — Project Settings → Environment Variables
# =============================================================================
# NEXT_PUBLIC_API_URL=https://tattoo-ai-backend.fly.dev
# TATTOO_BACKEND_URL=https://tattoo-ai-backend.fly.dev
# TATTOO_SERVICE_KEY=...            (same as backend TATTOO_SERVICE_KEY)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...     (server-only, never NEXT_PUBLIC_*)
