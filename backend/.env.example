# =============================================================================
# LOCAL DEVELOPMENT — copy to backend/.env and fill secrets
# =============================================================================
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

REPLICATE_API_TOKEN=
REQUIRE_API_KEY=true
TATTOO_SERVICE_KEY=
SKIP_CREDITS=1

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# PRODUCTION (Fly.io) — set via `fly secrets set` / fly.toml [env], NOT in git
# =============================================================================
# APP_ENV=production
# FRONTEND_URL=https://tattoovisionai.com
# BACKEND_URL=https://tattoo-ai-backend.fly.dev
# CORS_ORIGINS=https://tattoovisionai.com,https://www.tattoovisionai.com,https://tattoo-ai-flax.vercel.app
# SKIP_CREDITS=0
# REPLICATE_API_TOKEN=...
# TATTOO_SERVICE_KEY=...          (must match Vercel TATTOO_SERVICE_KEY)
# STRIPE_SECRET_KEY=...
# STRIPE_PRICE_ID=...
# STRIPE_WEBHOOK_SECRET=...

# --- Optional tuning ---
# GENERATE_RATE_LIMIT=20/minute
# STATUS_RATE_LIMIT=120/minute
# MAX_CONCURRENT_GENERATIONS=8
# MAX_UPLOAD_MB=8
# LOG_PROMPT_BODIES=0
